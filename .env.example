# Salin ke .env.local lalu sesuaikan. Semua opsional untuk development.

# Lokasi database SQLite (bawaan: data/ngebola.db)
DATABASE_PATH=data/ngebola.db

# URL publik aplikasi untuk tautan di email (production wajib HTTPS)
APP_URL=http://localhost:3000

# Email lewat Resend. Tanpa RESEND_API_KEY di development = mode demo (isi email dicetak di terminal).
# EMAIL_MODE=demo memaksa mode demo walau kunci ada.
RESEND_API_KEY=
EMAIL_FROM="Ngebola <noreply@domainmu.id>"
EMAIL_MODE=

# Web Push (VAPID) — buat dengan: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@domainmu.id

# Rahasia untuk memanggil /api/cron dari penjadwal (cron) server
CRON_SECRET=

# Alamat kontak untuk permintaan data pribadi (tampil di Kebijakan Privasi)
KONTAK_EMAIL=

# Peran Pemain ditahan (pendaftaran & promosi publik disembunyikan). Isi 1 untuk menyalakan lagi.
FITUR_PEMAIN=
